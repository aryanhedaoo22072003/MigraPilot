POSTGRES_DB=migrapilot
POSTGRES_USER=migrapilot
POSTGRES_PASSWORD=change-this-local-db-password
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
CORS_ORIGINS=http://localhost:5173
REDIS_URL=redis://redis:6379/0
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative provider:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_MAX_OUTPUT_TOKENS=4096
AI_CONVERSION_RATE_LIMIT_PER_MINUTE=5
AI_AUTOPSY_RATE_LIMIT_PER_MINUTE=3
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_PROVIDER_MAX_RETRIES=1
AI_AUTOPSY_REQUEST_BUDGET_SECONDS=45
AI_AUTOPSY_TASK_SOFT_LIMIT_SECONDS=60
AI_AUTOPSY_TASK_HARD_LIMIT_SECONDS=70
AI_AUTOPSY_STALE_AFTER_SECONDS=300
MASK_PII=true
MAX_UPLOAD_BYTES=10485760
MAX_ZIP_FILES=50
MAX_ZIP_UNCOMPRESSED_BYTES=52428800
SHADOW_LOADER_PASSWORD=replace-with-a-separate-shadow-loader-password
SHADOW_EXECUTOR_PASSWORD=replace-with-a-separate-shadow-executor-password
SHADOW_STATEMENT_TIMEOUT_MS=5000
SHADOW_JOB_TIMEOUT_SECONDS=30
SHADOW_MAX_ROWS=1000
SHADOW_MISMATCH_SAMPLE_LIMIT=25
SHADOW_DECIMAL_TOLERANCE=0.0001
AUTOPSY_MAX_SQL_CHARS=50000
AUTOPSY_MAX_EXPRESSION_CHARS=2000
AUTOPSY_MAX_TRANSFORMATIONS=100
AUTOPSY_MAX_PORTS=500
