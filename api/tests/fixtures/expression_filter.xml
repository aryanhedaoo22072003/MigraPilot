<?xml version="1.0" encoding="UTF-8"?>
<POWERMART CREATION_DATE="10/31/2026" REPOSITORY_VERSION="191.00">
  <REPOSITORY NAME="MIGRAPILOT_DEMO"><FOLDER NAME="SALES">
    <SOURCE NAME="SRC_ORDERS" DESCRIPTION="Order feed">
      <SOURCEFIELD NAME="ORDER_ID" DATATYPE="integer"/><SOURCEFIELD NAME="AMOUNT" DATATYPE="decimal"/>
    </SOURCE>
    <TARGET NAME="TGT_ORDERS"><TARGETFIELD NAME="ORDER_ID" DATATYPE="integer"/><TARGETFIELD NAME="NET_AMOUNT" DATATYPE="decimal"/></TARGET>
    <MAPPING NAME="m_orders_expression_filter" DESCRIPTION="Calculate and retain positive orders">
      <TRANSFORMATION NAME="EXP_NET" TYPE="Expression">
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="NET_AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="AMOUNT * 0.90"/>
      </TRANSFORMATION>
      <TRANSFORMATION NAME="FIL_POSITIVE" TYPE="Filter">
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="NET_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NET_AMOUNT &gt; 0"/>
      </TRANSFORMATION>
      <INSTANCE NAME="SRC_ORDERS" TRANSFORMATION_NAME="SRC_ORDERS" TYPE="SOURCE"/>
      <INSTANCE NAME="EXP_NET" TRANSFORMATION_NAME="EXP_NET" TYPE="TRANSFORMATION"/>
      <INSTANCE NAME="FIL_POSITIVE" TRANSFORMATION_NAME="FIL_POSITIVE" TYPE="TRANSFORMATION"/>
      <INSTANCE NAME="TGT_ORDERS" TRANSFORMATION_NAME="TGT_ORDERS" TYPE="TARGET"/>
      <CONNECTOR FROMINSTANCE="SRC_ORDERS" FROMFIELD="ORDER_ID" TOINSTANCE="EXP_NET" TOFIELD="ORDER_ID"/>
      <CONNECTOR FROMINSTANCE="SRC_ORDERS" FROMFIELD="AMOUNT" TOINSTANCE="EXP_NET" TOFIELD="AMOUNT"/>
      <CONNECTOR FROMINSTANCE="EXP_NET" FROMFIELD="ORDER_ID" TOINSTANCE="FIL_POSITIVE" TOFIELD="ORDER_ID"/>
      <CONNECTOR FROMINSTANCE="EXP_NET" FROMFIELD="NET_AMOUNT" TOINSTANCE="FIL_POSITIVE" TOFIELD="NET_AMOUNT"/>
      <CONNECTOR FROMINSTANCE="FIL_POSITIVE" FROMFIELD="ORDER_ID" TOINSTANCE="TGT_ORDERS" TOFIELD="ORDER_ID"/>
      <CONNECTOR FROMINSTANCE="FIL_POSITIVE" FROMFIELD="NET_AMOUNT" TOINSTANCE="TGT_ORDERS" TOFIELD="NET_AMOUNT"/>
    </MAPPING>
  </FOLDER></REPOSITORY>
</POWERMART>
