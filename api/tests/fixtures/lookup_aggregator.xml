<?xml version="1.0" encoding="UTF-8"?>
<POWERMART><REPOSITORY NAME="DEMO"><FOLDER NAME="FINANCE">
  <SOURCE NAME="SRC_TXN"><SOURCEFIELD NAME="ACCOUNT_ID" DATATYPE="integer"/><SOURCEFIELD NAME="AMOUNT" DATATYPE="decimal"/></SOURCE>
  <TARGET NAME="TGT_ACCOUNT_TOTAL"><TARGETFIELD NAME="ACCOUNT_NAME" DATATYPE="string"/><TARGETFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal"/></TARGET>
  <MAPPING NAME="m_account_totals" DESCRIPTION="Lookup account and aggregate transactions">
    <TRANSFORMATION NAME="LKP_ACCOUNT" TYPE="Lookup Procedure">
      <TRANSFORMFIELD NAME="ACCOUNT_ID" DATATYPE="integer" PORTTYPE="INPUT"/><TRANSFORMFIELD NAME="ACCOUNT_NAME" DATATYPE="string" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DIM_ACCOUNT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="AGG_TOTAL" TYPE="Aggregator">
      <TRANSFORMFIELD NAME="ACCOUNT_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/><TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="SUM(AMOUNT)"/>
    </TRANSFORMATION>
    <INSTANCE NAME="SRC_TXN" TRANSFORMATION_NAME="SRC_TXN"/><INSTANCE NAME="LKP_ACCOUNT" TRANSFORMATION_NAME="LKP_ACCOUNT"/>
    <INSTANCE NAME="AGG_TOTAL" TRANSFORMATION_NAME="AGG_TOTAL"/><INSTANCE NAME="TGT_ACCOUNT_TOTAL" TRANSFORMATION_NAME="TGT_ACCOUNT_TOTAL"/>
    <CONNECTOR FROMINSTANCE="SRC_TXN" FROMFIELD="ACCOUNT_ID" TOINSTANCE="LKP_ACCOUNT" TOFIELD="ACCOUNT_ID"/>
    <CONNECTOR FROMINSTANCE="LKP_ACCOUNT" FROMFIELD="ACCOUNT_NAME" TOINSTANCE="AGG_TOTAL" TOFIELD="ACCOUNT_NAME"/>
    <CONNECTOR FROMINSTANCE="SRC_TXN" FROMFIELD="AMOUNT" TOINSTANCE="AGG_TOTAL" TOFIELD="AMOUNT"/>
    <CONNECTOR FROMINSTANCE="AGG_TOTAL" FROMFIELD="ACCOUNT_NAME" TOINSTANCE="TGT_ACCOUNT_TOTAL" TOFIELD="ACCOUNT_NAME"/>
    <CONNECTOR FROMINSTANCE="AGG_TOTAL" FROMFIELD="TOTAL_AMOUNT" TOINSTANCE="TGT_ACCOUNT_TOTAL" TOFIELD="TOTAL_AMOUNT"/>
  </MAPPING>
</FOLDER></REPOSITORY></POWERMART>
