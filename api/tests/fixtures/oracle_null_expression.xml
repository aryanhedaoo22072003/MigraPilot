<?xml version="1.0" encoding="UTF-8"?>
<POWERMART><REPOSITORY NAME="DEMO"><FOLDER NAME="HR">
  <SOURCE NAME="SRC_EMP"><SOURCEFIELD NAME="EMP_ID" DATATYPE="integer"/><SOURCEFIELD NAME="BONUS" DATATYPE="decimal"/></SOURCE>
  <TARGET NAME="TGT_EMP"><TARGETFIELD NAME="EMP_ID" DATATYPE="integer"/><TARGETFIELD NAME="BONUS_NORMALIZED" DATATYPE="decimal"/></TARGET>
  <MAPPING NAME="m_oracle_null_semantics" DESCRIPTION="Preserves an Oracle NVL expression for later reviewed conversion">
    <TRANSFORMATION NAME="EXP_NULLS" TYPE="Expression">
      <TRANSFORMFIELD NAME="EMP_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
      <TRANSFORMFIELD NAME="BONUS" DATATYPE="decimal" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD NAME="BONUS_NORMALIZED" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="NVL(BONUS, 0)"/>
    </TRANSFORMATION>
    <INSTANCE NAME="SRC_EMP" TRANSFORMATION_NAME="SRC_EMP"/><INSTANCE NAME="EXP_NULLS" TRANSFORMATION_NAME="EXP_NULLS"/><INSTANCE NAME="TGT_EMP" TRANSFORMATION_NAME="TGT_EMP"/>
    <CONNECTOR FROMINSTANCE="SRC_EMP" FROMFIELD="EMP_ID" TOINSTANCE="EXP_NULLS" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMINSTANCE="SRC_EMP" FROMFIELD="BONUS" TOINSTANCE="EXP_NULLS" TOFIELD="BONUS"/>
    <CONNECTOR FROMINSTANCE="EXP_NULLS" FROMFIELD="EMP_ID" TOINSTANCE="TGT_EMP" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_NULLS" FROMFIELD="BONUS_NORMALIZED" TOINSTANCE="TGT_EMP" TOFIELD="BONUS_NORMALIZED"/>
  </MAPPING>
</FOLDER></REPOSITORY></POWERMART>
