          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deleted project returns 404: HTTP 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
