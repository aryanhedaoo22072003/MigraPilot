{
  "info": {
    "name": "MigraPilot \u2014 Phase 1 API Tests",
    "_postman_id": "9f3481f8-bdfd-4adc-9b65-41355c6daa91",
    "description": "Run with the MigraPilot Local environment in order. Disposable local test accounts, JWT and project CRUD. No Phase 2 endpoints are implemented yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 \u2014 Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health check: HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Service is healthy\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 \u2014 Auth",
      "item": [
        {
          "name": "Register user (save token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{local_test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"test_email\", \"migrapilot_\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Register user (save token): HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returned token and normalized email\", function () { pm.expect(data.access_token).to.be.a('string'); pm.expect(data.user.email).to.eql(pm.environment.get('test_email')); });",
                  "if (data.access_token) { pm.environment.set('token', data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (refresh token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{local_test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login (refresh token): HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Login has access token\", function () { pm.expect(data.access_token).to.be.a('string'); });",
                  "if (data.access_token) { pm.environment.set('token', data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Current user: HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Me returns registered email\", function () { pm.expect(pm.response.json().email).to.eql(pm.environment.get(\"test_email\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth required (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Auth required (401): HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Incorrect password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Incorrect password (401): HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate registration (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{local_test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate registration (409): HTTP 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 \u2014 Projects",
      "item": [
        {
          "name": "Create project (save project ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/projects",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Migration\",\n  \"source_system\": \"powercenter\",\n  \"target_system\": \"dbt_postgres\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Create project (save project ID): HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Project has numeric ID\", function () { pm.expect(data.id).to.be.a('number'); pm.expect(data.name).to.eql('Postman Test Migration'); });",
                  "if (data.id) { pm.environment.set('project_id', String(data.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/projects",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"List projects: HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"List contains new project\", function () { pm.expect(pm.response.json().some(p => String(p.id) === pm.environment.get(\"project_id\"))).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/projects/{{project_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Get project: HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Project ID matches\", function () { pm.expect(String(pm.response.json().id)).to.eql(pm.environment.get(\"project_id\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Project dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/projects/{{project_id}}/dashboard",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Project dashboard: HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"New project has zero mappings\", function () { pm.expect(pm.response.json().total_mappings).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename project",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/projects/{{project_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Migration Updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Rename project: HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Name updated\", function () { pm.expect(pm.response.json().name).to.eql(\"Postman Test Migration Updated\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/projects/{{project_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Delete project: HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Deleted project returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/projects/{{project_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
